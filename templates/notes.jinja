{% extends 'base.jinja' %}

{% block nav_sub %}
            <div class="nav-sub">
                <div class="conference-tabs">
                    <button class="conference-tab active" data-tab="simulation">数値シミュレーション</button>
                    <button class="conference-tab" data-tab="supplement">講義の補助資料</button>
                </div>
            </div>
{% endblock %}

{% block head_extra %}
    <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <script>
        (function() {
            try {
                const theme = localStorage.getItem('theme');
                if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            } catch (_) {}
        })();
    </script>
    <style>
        .tab-section { display: none; }
        .tab-section.active { display: block; }
        .subtabs-ribbon {
            display: flex;
            gap: 0.5rem;
            margin: 4px 0 0 0;
            padding: 0 1rem;
            flex-wrap: wrap;
        }
        .subtab-btn {
            font-size: 13px;
            padding: 4px 12px;
            border: 1px solid #d0d7de;
            background-color: #f6f8fa;
            color: #222;
            cursor: pointer;
            border-radius: 6px;
            white-space: nowrap;
        }
        .subtab-btn.active, .subtab-btn:focus {
            background-color: #007711;
            color: #fff;
            border-color: #007711;
        }
        .subtab-content { display: none; }
        .subtab-content.active { display: block; }
        #taylor-plot, #wave-plot {
            width: 100% !important;
            min-width: 300px;
            min-height: 300px;
        }
        .slider-container {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin: 0.5rem 0;
            flex-wrap: wrap;
        }
        .slider-container input[type="range"] { min-width: 160px; flex: 1; }
        .sim-controls {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem 1.5rem;
            align-items: center;
            margin: 1rem 0;
        }
        .sim-controls button {
            padding: 6px 14px;
            border: 1px solid #d0d7de;
            border-radius: 6px;
            background: #f6f8fa;
            cursor: pointer;
        }
        html.dark .sim-controls button {
            background: #262d31;
            border-color: #444;
            color: #eee;
        }
        #coupled-oscillator-canvas {
            width: 100%;
            height: 240px;
            display: block;
            border: 1px solid #d0d7de;
            border-radius: 6px;
            touch-action: none;
            cursor: grab;
        }
        html.dark #coupled-oscillator-canvas { border-color: #444; }
        .linear-transform-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            padding: 20px 0;
        }
        .matrix-input { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
        .matrix-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .matrix-grid input { width: 60px; padding: 5px; }
        .canvas-container { display: flex; gap: 40px; flex-wrap: wrap; justify-content: center; }
        .canvas-container canvas {
            border: 1px solid #ccc;
            background-color: #f8f8f8;
            max-width: 100%;
        }
        .scale-control { display: flex; align-items: center; gap: 10px; margin: 12px 0; }
        .proposition, .remark {
            background: #f6f8fa;
            border-left-width: 4px;
            padding: 12px 16px;
            margin: 16px 0;
            border-radius: 6px;
        }
        .proposition { border-left: 4px solid #007711; }
        .remark { border-left: 4px solid #ff8800; }
        html.dark .proposition, html.dark .remark {
            background: #262d31;
            color: #fff;
        }
        html.dark .proposition { border-left: 4px solid #33cc77; }
        html.dark .remark { border-left: 4px solid #ffb366; }
        html.dark .proposition .mjx-math,
        html.dark .remark .mjx-math,
        html.dark .proposition .mjx-chtml,
        html.dark .remark .mjx-chtml {
            color: #fff !important;
        }
        html.dark .subtab-btn {
            background-color: #262d31;
            color: #eee;
            border-color: #444;
        }
        html.dark .subtab-btn.active {
            background-color: #007711;
            color: #fff;
            border-color: #007711;
        }
    </style>
</head>
<body>
{% endblock %}

{% block before_content %}
    <div id="simulation-subtabs" class="subtabs-ribbon" style="display:flex;">
        <button class="subtab-btn active" data-subtab="coupled-oscillator">1次元連成振動</button>
        <button class="subtab-btn" data-subtab="taylor">sinのテイラー展開</button>
        <button class="subtab-btn" data-subtab="linear-transform">線型変換</button>
        <button class="subtab-btn" data-subtab="damped-wave">線型消散型波動方程式の解作用素</button>
    </div>
    <div id="supplement-subtabs" class="subtabs-ribbon" style="display:none;">
        <button class="subtab-btn active" data-subtab="differentiability">全微分可能性</button>
    </div>

{% endblock %}

{% block content %}
        <div id="simulation-section" class="tab-section active">
            <div id="coupled-oscillator-subtab" class="subtab-content active">
                <div class="container">
                    <h2>1次元連成振動</h2>
                    <p>
                        両端を固定したばね・質点系です。質点は等間隔に配置し、ばね定数 $k$ と質量 $m$ は共通です。
                        停止中に質点を左右へドラッグして初期変位を与え、再生で時間発展を見られます。
                    </p>
                    <div class="sim-controls">
                        <div class="slider-container">
                            <label for="co-n-slider">質点数 $N$:</label>
                            <input type="range" id="co-n-slider" min="1" max="10" step="1" value="3">
                            <span id="co-n-value">3</span>
                        </div>
                        <div class="slider-container">
                            <label for="co-k-slider">ばね定数 $k$:</label>
                            <input type="range" id="co-k-slider" min="1" max="80" step="1" value="20">
                            <span id="co-k-value">20</span>
                        </div>
                        <div class="slider-container">
                            <label for="co-m-slider">質量 $m$:</label>
                            <input type="range" id="co-m-slider" min="0.2" max="5" step="0.1" value="1">
                            <span id="co-m-value">1</span>
                        </div>
                        <button type="button" id="co-play-btn">再生</button>
                        <button type="button" id="co-reset-btn">リセット</button>
                    </div>
                    <canvas id="coupled-oscillator-canvas" width="800" height="240" aria-label="連成振動キャンバス"></canvas>
                    <p class="text-math">
                        変位 $u_i$（平衡位置からのずれ）に対し、両端固定 $u_0 = u_{N+1} = 0$ のもとで
                        \[
                        m\ddot u_i = k(u_{i-1}-u_i)+k(u_{i+1}-u_i)
                        = k(u_{i-1}-2u_i+u_{i+1})
                        \]
                        が成り立ちます。
                    </p>
                </div>
            </div>

            <div id="taylor-subtab" class="subtab-content">
                <div class="container">
                    <h2>sinのテイラー展開</h2>
                    <div class="controls">
                        <div class="slider-container">
                            <label for="n-slider">次数 n:</label>
                            <input type="range" id="n-slider" min="1" max="20" step="1" value="5">
                            <span id="n-value">5</span>
                        </div>
                        <div class="slider-container">
                            <label for="x-range-slider">x軸範囲:</label>
                            <input type="range" id="x-range-slider" min="1" max="4" step="1" value="2">
                            <span id="x-range-value">2π</span>
                        </div>
                    </div>
                    <div id="taylor-plot"></div>
                    <p class="text-math">
                        \[
                        \sin(x) = \sum_{k=0}^{\infty} \frac{(-1)^k}{(2k+1)!} x^{2k+1}
                        \]
                    </p>
                </div>
            </div>

            <div id="linear-transform-subtab" class="subtab-content">
                <div class="container">
                    <h2>2x2行列による線形変換の可視化</h2>
                    <div class="linear-transform-container">
                        <div class="matrix-input">
                            <div class="matrix-grid">
                                <input type="number" id="a11" value="1" step="0.1">
                                <input type="number" id="a12" value="0" step="0.1">
                                <input type="number" id="a21" value="0" step="0.1">
                                <input type="number" id="a22" value="1" step="0.1">
                            </div>
                            <div class="matrix-info">
                                <div>階数: <span id="rankValue">2</span></div>
                                <div>固有ベクトル数: <span id="eigenvectorCount">2</span></div>
                            </div>
                        </div>
                        <div class="scale-control">
                            <label for="scale">画像のスケール:</label>
                            <input type="range" id="scale" min="0.1" max="2" step="0.1" value="1">
                            <span id="scaleValue">1.0</span>
                        </div>
                        <div class="canvas-container">
                            <canvas id="originalCanvas" width="400" height="400"></canvas>
                            <canvas id="transformedCanvas" width="400" height="400"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div id="damped-wave-subtab" class="subtab-content">
                <div class="container">
                    <h2>線型消散型波動方程式の解作用素</h2>
                    <div class="controls">
                        <div class="slider-container">
                            <label for="t-slider">t: </label>
                            <input type="range" id="t-slider" min="1" max="100" value="10" />
                            <span id="t-value">10</span>
                        </div>
                        <div class="slider-container">
                            <label for="k-slider">近似次数 k: </label>
                            <input type="range" id="k-slider" min="1" max="50" value="20" />
                            <span id="k-value">20</span>
                        </div>
                    </div>
                    <div id="wave-plot"></div>
                </div>
            </div>
        </div>

        <div id="supplement-section" class="tab-section">
            <div id="differentiability-subtab" class="subtab-content active">
                <div class="container">
                    <div id="differentiability-note" style="width:100%;min-height:70vh;"></div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script type="module">
        import { setupTaylorSim } from '{{ base }}js/simulation/taylor.js';
        import { setupLinearDampedWaveSim } from '{{ base }}js/simulation/linear_damped_wave.js';
        import { setupCoupledOscillatorSim } from '{{ base }}js/simulation/coupled_oscillator.js';
        import { renderDifferentiabilityNote } from '{{ base }}js/note/differentiability.js';

        function rerenderMathJax() {
            if (window.MathJax?.typesetPromise) {
                window.MathJax.typesetPromise().catch((err) => {
                    console.error('MathJax typesetting failed: ' + err.message);
                });
            }
        }

        function setupTabs() {
            const tabBtns = document.querySelectorAll('.conference-tab');
            const tabSections = document.querySelectorAll('.tab-section');
            const simRibbon = document.getElementById('simulation-subtabs');
            const supplementRibbon = document.getElementById('supplement-subtabs');
            const subtabContents = document.querySelectorAll('.subtab-content');

            function showRibbon(which) {
                simRibbon.style.display = which === 'simulation' ? 'flex' : 'none';
                supplementRibbon.style.display = which === 'supplement' ? 'flex' : 'none';
            }

            function activateSubtab(id) {
                document.querySelectorAll('.subtab-btn').forEach(b => {
                    b.classList.toggle('active', b.dataset.subtab === id);
                });
                subtabContents.forEach(tc => {
                    tc.classList.toggle('active', tc.id === id + '-subtab');
                });
                if (id === 'taylor') {
                    setTimeout(() => Plotly.Plots.resize(document.getElementById('taylor-plot')), 0);
                } else if (id === 'damped-wave') {
                    setTimeout(() => Plotly.Plots.resize(document.getElementById('wave-plot')), 0);
                } else if (id === 'linear-transform') {
                    import('../js/linear_transform.js').then(m => m.initializeLinearTransform());
                } else if (id === 'differentiability') {
                    renderDifferentiabilityNote(document.getElementById('differentiability-note'));
                }
                setTimeout(rerenderMathJax, 50);
            }

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    tabBtns.forEach(b => b.classList.remove('active'));
                    tabSections.forEach(tc => tc.classList.remove('active'));
                    btn.classList.add('active');
                    document.getElementById(btn.dataset.tab + '-section').classList.add('active');
                    showRibbon(btn.dataset.tab);
                    if (btn.dataset.tab === 'simulation') {
                        const active = simRibbon.querySelector('.subtab-btn.active')?.dataset.subtab || 'coupled-oscillator';
                        activateSubtab(active);
                    } else if (btn.dataset.tab === 'supplement') {
                        activateSubtab('differentiability');
                    }
                });
            });

            document.querySelectorAll('.subtab-btn').forEach(btn => {
                btn.addEventListener('click', () => activateSubtab(btn.dataset.subtab));
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            setupTabs();
            setupCoupledOscillatorSim();
            setupTaylorSim(
                document.getElementById('n-slider'),
                document.getElementById('n-value'),
                document.getElementById('x-range-slider'),
                document.getElementById('x-range-value'),
                document.getElementById('taylor-plot')
            );
            setupLinearDampedWaveSim(document.getElementById('wave-plot'));

            const activeTab = document.querySelector('.conference-tab.active')?.dataset.tab;
            if (activeTab === 'simulation') {
                document.getElementById('simulation-subtabs').style.display = 'flex';
            }
            if (activeTab === 'supplement') {
                document.getElementById('supplement-subtabs').style.display = 'flex';
                renderDifferentiabilityNote(document.getElementById('differentiability-note'));
            }
        });
    </script>
    <script>
        function applyDarkMode() {
            const theme = localStorage.getItem('theme');
            if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        }
        window.addEventListener('storage', applyDarkMode);
    </script>
{% endblock %}
